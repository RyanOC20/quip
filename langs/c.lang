quip-lang 1
# C. quip also has C built in, so it works with no language files
# installed; this file replaces the built-in copy when present.
# .h headers belong to cpp.lang, since C++ keywords are harmless in C.

extensions    .c
line_comment  //
block_comment /* */
features      strings numbers

keywords
  auto break case continue default do else enum extern for goto if
  inline register restrict return sizeof static struct switch typedef
  union volatile while NULL
  # C11 and C23
  _Alignas _Alignof _Atomic _Bool _Complex _Generic _Imaginary _Noreturn
  _Static_assert _Thread_local alignas alignof constexpr false nullptr
  static_assert thread_local true typeof

types
  int long double float char unsigned signed void short const bool
  size_t ssize_t ptrdiff_t intptr_t uintptr_t int8_t int16_t int32_t
  int64_t uint8_t uint16_t uint32_t uint64_t FILE
